{
  "schemaVersion": 1,
  "id": "villager_customers",
  "version": "${version}",
  "name": "Create Fly: Villager Customers",
  "description": "Villagers walk to your Create shops during their working hours and trade their own offers against them, paying into the stock ticker and earning it experience nuggets.",
  "authors": [
    "Cube Algos"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/villager-customers",
    "sources": "https://git.cubealgos.de/cubealgos/create_villager_customers",
    "issues": "https://github.com/cubealgos/create_villager_customers/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "villager_customers.VillagerCustomers"
    ],
    "client": [
      "villager_customers.client.VillagerCustomersClient"
    ]
  },
  "mixins": [
    "villager_customers.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.160.0",
    "create": "6.0.9-1"
  }
}
